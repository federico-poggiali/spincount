{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseResult",
  "type": "object",
  "required": ["discogs_release_id", "tracks", "adapters_off", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "discogs_release_id": {"type": "integer"},
    "adapters_off": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string"},
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "status", "audio_path", "source", "level", "url", "quality", "confidence", "reason", "readings", "alternatives"],
        "additionalProperties": false,
        "properties": {
          "position": {"type": "string"},
          "status": {"enum": ["found", "review", "not_found"]},
          "audio_path": {"type": ["string", "null"]},
          "source": {"type": ["string", "null"]},
          "level": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "url": {"type": ["string", "null"]},
          "quality": {"enum": ["full", "preview", "clip", null]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"},
          "readings": {"type": "array", "items": {"$ref": "#/$defs/reading"}},
          "alternatives": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  },
  "$defs": {
    "reading": {
      "type": "object",
      "required": ["source"],
      "properties": {"source": {"type": "string"}, "bpm": {"type": ["number", "null"]}, "key": {"type": ["string", "null"]}}
    }
  }
}
